# Joy Wallet / Telegram Mini App

# Existing Supabase project
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram BotFather token (server only)
TELEGRAM_BOT_TOKEN=

# Paystack secret key (server only)
PAYSTACK_SECRET_KEY=

# Monetag TMA SDK configuration
# Create a Telegram Mini App + Rewarded Interstitial tag in Monetag,
# then paste the exact SDK script URL from "Get instructions".
MONETAG_TMA_ZONE_ID=
NEXT_PUBLIC_MONETAG_SDK_SRC=
NEXT_PUBLIC_MONETAG_SDK_FUNCTION=

# Optional Joy Wallet economics
JOY_WALLET_AD_REWARD_KOBO=500
JOY_WALLET_MIN_WITHDRAWAL_KOBO=50000
JOY_WALLET_DAILY_AD_LIMIT=500
